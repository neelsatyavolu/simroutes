# Schedule ingest (scripts/ingest.ts). Not needed to run the app.
AERODATABOX_RAPIDAPI_KEY=

# Flight schedule store. Without it, flights read and write data/flights.json locally.
BLOB_READ_WRITE_TOKEN=

# Neon Postgres for logbook, suggestions and planner. Migrations prefer the unpooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: dedicated key for encrypting Volanta session cookies. Falls back to CLERK_SECRET_KEY.
VOLANTA_SESSION_SECRET=

# Issued by Navigraph (dev@navigraph.com). Planner works without them; Navigraph connect stays disabled.
NAVIGRAPH_CLIENT_ID=
NAVIGRAPH_CLIENT_SECRET=
# Optional: must match the redirect URI registered with Navigraph. Defaults to <origin>/api/navigraph/callback
NAVIGRAPH_REDIRECT_URI=
